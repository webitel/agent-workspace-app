# Environment used by Playwright e2e tests (`vite --mode e2e`).
# Points at the shared test instance. The access token itself lives in
# `.env.e2e.local` (gitignored) — see `.env.e2e.local.example`.

# Origin proxied by the dev/preview server (see `vite.config.ts`). The app
# itself talks to the same-origin paths below, so no CORS preflight is needed.
E2E_API_ORIGIN = 'https://test.webitel.me'

VITE_API_URL = '/api'
VITE_CHAT_URL = '/chat'

VITE_AUTH_URL = 'https://test.webitel.me/app/auth'

VITE_ADMIN_URL = 'https://test.webitel.me/admin'
VITE_AGENT_URL = 'https://test.webitel.me/workspace'
VITE_SUPERVISOR_URL = 'https://test.webitel.me/supervisor'
VITE_AUDIT_URL = 'https://test.webitel.me/audit'
VITE_HISTORY_URL = 'https://test.webitel.me/history'
VITE_GRAFANA_URL = 'https://test.webitel.me/grafana'
VITE_CRM_URL = 'https://test.webitel.me/crm'
VITE_OMNI_WIDGET_URL = 'https://test.webitel.me/omni-widget'
VITE_FLOW_DIAGRAM_URL = 'https://test.webitel.me/flow'
VITE_SETTINGS_URL = 'https://test.webitel.me/settings'
VITE_START_PAGE_URL = 'https://test.webitel.me/'
VITE_RINGTONES_URL = 'https://test.webitel.me/ringtones'

VITE_WEB_SOCKET_URL = 'wss://test.webitel.me/ws'
VITE_CHAT_WEB_SOCKET_URL = 'wss://test.webitel.me/im/ws'
